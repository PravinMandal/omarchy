#!/bin/bash

# omarchy:summary=Toggle automatic recovery for monitors that lose power
# omarchy:name=monitor-power-guard
# omarchy:args=[on|off|toggle]

set -uo pipefail

readonly FLAG=monitor-power-guard
readonly SERVICE=omarchy-hyprland-monitor-power-guard.service
readonly omarchy_path=$OMARCHY_PATH
readonly unit_source="$omarchy_path/default/systemd/user/$SERVICE"
readonly unit_target="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$SERVICE"
action=${1:-toggle}

if [[ $action != "on" && $action != "off" && $action != "toggle" ]]; then
  echo "Usage: $(basename "$0") {on|off|toggle}" >&2
  exit 1
fi

notify() {
  omarchy-notification-send -g 󰍹 "$1" >/dev/null 2>&1 || true
}

failed() {
  notify "$(omarchy-i18n monitor.powerGuardFailed)"
  exit 1
}

enabled() {
  omarchy-toggle-enabled "$FLAG"
}

enable() {
  [[ -f $unit_source ]] || failed

  mkdir -p "$(dirname "$unit_target")" || failed
  install -Dm644 "$unit_source" "$unit_target" || failed
  systemctl --user daemon-reload >/dev/null 2>&1 || failed

  omarchy-toggle "$FLAG" on >/dev/null || failed

  if ! systemctl --user enable --now "$SERVICE" >/dev/null 2>&1; then
    systemctl --user disable --now "$SERVICE" >/dev/null 2>&1 || true
    omarchy-toggle "$FLAG" off >/dev/null
    failed
  fi

  notify "$(omarchy-i18n monitor.powerGuardEnabled)"
}

disable() {
  # Stop the service before removing its opt-in flag. If the stop fails, the
  # flag stays so the user can see that the guard is still active and retry.
  # Ask systemd to stop even when the unit file moved; a failed stop is only
  # fatal if the service is still active.
  if ! systemctl --user stop "$SERVICE" >/dev/null 2>&1; then
    if systemctl --user is-active --quiet "$SERVICE" >/dev/null 2>&1; then
      failed
    fi
  fi

  # The guard may have disabled an output before it was turned off. Put the
  # saved layouts back and clear its state. A failed restore is transactional:
  # keep the service and flag so the guard can recover when the monitor returns.
  if ! MONITOR_POWER_GUARD_NO_NOTIFY=1 omarchy-hyprland-monitor-power-guard --restore-all >/dev/null 2>&1; then
    systemctl --user start "$SERVICE" >/dev/null 2>&1 || true
    failed
  fi

  if omarchy-hyprland-reload-guard paused; then
    :
  else
    timeout 10 hyprctl reload >/dev/null 2>&1 || true
  fi

  if ! systemctl --user disable "$SERVICE" >/dev/null 2>&1 && [[ -f $unit_target ]]; then
    failed
  fi

  omarchy-toggle "$FLAG" off >/dev/null || failed
  notify "$(omarchy-i18n monitor.powerGuardDisabled)"
}

case $action in
  on) enable ;;
  off) disable ;;
  toggle)
    if enabled; then
      disable
    else
      enable
    fi
    ;;
esac
